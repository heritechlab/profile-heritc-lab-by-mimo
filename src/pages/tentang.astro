---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import SkillGrid from '../components/SkillGrid.astro';
import SocialBar from '../components/SocialBar.astro';
import { loadGenerated, relatif } from '../lib/data';
import { profile } from '../lib/content';

const { github } = await loadGenerated();
const aktivitas = [...github.repos].sort((a, b) => +new Date(b.updatedAt) - +new Date(a.updatedAt));
---

<Base
  title="Tentang"
  description={`${profile.nama} (${profile.namaSosial}) — ${profile.posisi}. Berbasis di ${profile.lokasi}, menangani jaringan, server, PLTS, dan pengembangan web.`}
>
  <PageHead
    label="Tentang"
    title="Heri Saputra, dikenal sebagai Heri Tc Lab"
    lead={profile.bio}
  />

  <section class="section">
    <div class="wrap tentang">
      <div class="tentang__teks">
        <p class="lead">{profile.bioLanjutan}</p>

        <dl class="fakta">
          <div>
            <dt class="readout">Nama lengkap</dt>
            <dd>{profile.nama}</dd>
          </div>
          <div>
            <dt class="readout">Nama kanal</dt>
            <dd>{profile.namaSosial}</dd>
          </div>
          <div>
            <dt class="readout">Lokasi</dt>
            <dd>{profile.lokasi} <span class="muted">({profile.zonaWaktu})</span></dd>
          </div>
          <div>
            <dt class="readout">Bahasa</dt>
            <dd>{profile.bahasa.join(' · ')}</dd>
          </div>
        </dl>

        <div class="minat">
          <p class="readout minat__label">Minat</p>
          <ul>
            {profile.minat.map((m) => <li class="chip">{m}</li>)}
          </ul>
        </div>

        <div class="sosial">
          <p class="readout minat__label">Terhubung</p>
          <SocialBar />
        </div>
      </div>

      <aside class="tentang__reakam">
        <p class="readout rekap__label">Rekam jejak terakhir</p>
        <ul class="reakam">
          {
            aktivitas.slice(0, 6).map((r) => (
              <li>
                <a href={r.url} target="_blank" rel="noopener noreferrer">
                  <span class="reakam__nama">{r.name}</span>
                  <span class="reakam__meta readout">
                    {r.language || '—'} · {relatif(r.updatedAt)}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="rekap__link" href="https://github.com/heritechlab" target="_blank" rel="noopener noreferrer me">
          github.com/heritechlab
        </a>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead
        label="Keahlian"
        title="Apa yang saya kerjakan"
        lead="Kelompok keahlian yang saya pakai sehari-hari, dari rak jaringan sampai rilis aplikasi."
      />
      <SkillGrid />
    </div>
  </section>
</Base>

<style>
  .tentang {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }
  @media (min-width: 62rem) {
    .tentang {
      grid-template-columns: minmax(0, 1fr) minmax(0, 19rem);
      align-items: start;
    }
  }

  .lead {
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    line-height: 1.6;
    max-width: 62ch;
    color: var(--text);
  }

  .fakta {
    display: grid;
    gap: 1px;
    margin: clamp(1.75rem, 4vw, 2.5rem) 0 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 36rem) {
    .fakta {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .fakta > div {
    background: var(--surface);
    padding: 0.9rem 1.1rem;
  }
  .fakta dt {
    color: var(--muted-2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.65rem;
  }
  .fakta dd {
    margin: 0.25rem 0 0;
    font-weight: 600;
  }
  .muted {
    color: var(--muted);
    font-weight: 400;
  }

  .minat,
  .sosial {
    margin-top: 1.75rem;
  }
  .minat__label {
    color: var(--muted-2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.65rem;
    margin-bottom: 0.65rem;
  }
  .minat ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tentang__reakam {
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: 1.15rem 1.2rem 1.3rem;
  }
  .rekap__label {
    color: var(--muted-2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.65rem;
    margin-bottom: 0.85rem;
  }
  .reakam {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .reakam a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.7rem 0;
    border-bottom: 1px dashed var(--line);
    text-decoration: none;
  }
  .reakam li:last-child a {
    border-bottom: 0;
  }
  .reakam a:hover .reakam__nama {
    color: var(--accent-ink);
  }
  .reakam__nama {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .reakam__meta {
    color: var(--muted-2);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
  }
  .rekap__link {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-ink);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    word-break: break-all;
  }
</style>
