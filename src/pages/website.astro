---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import WebsiteCard from '../components/WebsiteCard.astro';
import SectionHead from '../components/SectionHead.astro';
import { websites as dataWebsites } from '../lib/content';

const daftar = dataWebsites.websites;
const aktif = daftar.filter((w) => w.status === 'aktif').length;
const peranUnik = [...new Set(daftar.map((w) => w.peran))];
---

<Base
  title="Situs"
  description="Website yang dikelola Heri Tc Lab — situs kampus STIKES Harapan Ibu Jambi, katalog perpustakaan, platform UMKM udigi.id, dan layanan hostidmurah.web.id."
>
  <PageHead
    label="Situs"
    title="Website yang saya kelola"
    lead={`${aktif} dari ${daftar.length} situs berstatus aktif · ${peranUnik.join(' · ')}. Daftar ini dibaca dari satu file data, jadi bisa diperbarui tanpa menyentuh kode.`}
  />

  <section class="section">
    <div class="wrap">
      <div class="grid">
        {daftar.map((w, i) => <WebsiteCard site={w} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead
        label="Cara kerja"
        title="Satu file, banyak kartu"
        lead="Menambah situs cukup dengan menambah satu entri di src/data/websites.yml — nama, URL, peran, stack, dan status. Tidak ada kode yang perlu diubah, dan kartu baru langsung tampil di halaman ini serta di beranda."
      />
      <div class="catuan">
        <div class="catuan__blok">
          <p class="readout catuan__label">File sumber</p>
          <code>src/data/websites.yml</code>
        </div>
        <div class="catuan__blok">
          <p class="readout catuan__label">Field wajib</p>
          <ul>
            <li>nama · url · deskripsi</li>
            <li>peran · stack · status</li>
          </ul>
        </div>
        <div class="catuan__blok">
          <p class="readout catuan__label">Field opsional</p>
          <ul>
            <li>tanggungJawab</li>
            <li>screenshot (file di <code>public/</code>)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    gap: clamp(0.85rem, 2vw, 1.25rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }

  .catuan {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 46rem) {
    .catuan {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .catuan__blok {
    background: var(--surface);
    padding: 1.1rem 1.2rem;
  }
  .catuan__label {
    color: var(--muted-2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.65rem;
    margin-bottom: 0.6rem;
  }
  .catuan__blok code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent-ink);
    word-break: break-all;
  }
  .catuan__blok ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .catuan__blok li code {
    font-size: 0.9em;
  }
</style>
