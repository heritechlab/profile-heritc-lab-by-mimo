---
import { profile, social } from '../lib/content';
import Icon from './Icon.astro';
import SocialBar from './SocialBar.astro';

const wa = profile.kontak.whatsapp;
const waHref = wa
  ? `https://wa.me/${wa.replace(/\D/g, '')}?text=${encodeURIComponent('Halo Heri, saya ingin membicarakan proyek.')}`
  : '';
const email = profile.kontak.email;
const key = import.meta.env.WEB3FORMS_KEY as string | undefined;
const terisi = Boolean(key);
---

<div class="kontak">
  <div class="kontak__kanal">
    <h3 class="kontak__sub">Langsung saja</h3>
    <ul class="kanal">
      {
        email && (
          <li>
            <a href={`mailto:${email}`}>
              <span class="kanal__ikon" aria-hidden="true">
                <Icon name="mail" size={18} />
              </span>
              <span class="kanal__teks">
                <strong>Email</strong>
                <span>{email}</span>
              </span>
            </a>
          </li>
        )
      }
      {
        waHref && (
          <li>
            <a href={waHref} target="_blank" rel="noopener noreferrer">
              <span class="kanal__ikon" aria-hidden="true">
                <Icon name="whatsapp" size={18} />
              </span>
              <span class="kanal__teks">
                <strong>WhatsApp</strong>
                <span>Chat langsung, balasan cepat</span>
              </span>
            </a>
          </li>
        )
      }
      {
        social.github.url && (
          <li>
            <a href={social.github.url} target="_blank" rel="noopener noreferrer me">
              <span class="kanal__ikon" aria-hidden="true">
                <Icon name="github" size={18} />
              </span>
              <span class="kanal__teks">
                <strong>GitHub</strong>
                <span>{social.github.username}</span>
              </span>
            </a>
          </li>
        )
      }
      {
        social.youtube.url && (
          <li>
            <a href={social.youtube.url} target="_blank" rel="noopener noreferrer me">
              <span class="kanal__ikon" aria-hidden="true">
                <Icon name="youtube" size={18} />
              </span>
              <span class="kanal__teks">
                <strong>YouTube</strong>
                <span>{social.youtube.handle}</span>
              </span>
            </a>
          </li>
        )
      }
    </ul>

    <div class="kontak__sosial">
      <p class="kontak__catatan">Media sosial lain</p>
      <SocialBar />
    </div>
  </div>

  <form class="form" id="form-kontak" novalidate>
    <h3 class="kontak__sub">Kirim pesan</h3>

    {!terisi && (
      <p class="form__peringatan" role="note">
        Form belum aktif: isi <code>WEB3FORMS_KEY</code> di file <code>.env</code> lalu build ulang.
      </p>
    )}

    <div class="form__row">
      <div class="field">
        <label for="nama">Nama</label>
        <input id="nama" name="name" type="text" autocomplete="name" required placeholder="Nama Anda" />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          placeholder="nama@email.com"
        />
      </div>
    </div>

    <div class="field">
      <label for="topik">Topik</label>
      <select id="topik" name="subject">
        <option value="Kerja sama proyek">Kerja sama proyek</option>
        <option value="Jasa pengembangan web">Jasa pengembangan web</option>
        <option value="Jaringan & server">Jaringan & server</option>
        <option value="PLTS & monitoring">PLTS & monitoring</option>
        <option value="Lainnya">Lainnya</option>
      </select>
    </div>

    <div class="field">
      <label for="pesan">Pesan</label>
      <textarea
        id="pesan"
        name="message"
        rows="5"
        required
        placeholder="Ceritakan singkat kebutuhan atau pertanyaan Anda."></textarea>
    </div>

    <input type="hidden" name="access_key" value={key ?? ''} />
    <input type="hidden" name="from_name" value="Website Heri Tc Lab" />
    <input type="hidden" name="redirect" value="false" />
    <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

    <div class="form__aksi">
      <button class="btn btn--primary" type="submit" data-submit>
        <span data-label>Kirim Pesan</span>
      </button>
      <p class="form__status readout" data-status role="status" aria-live="polite"></p>
    </div>
  </form>
</div>

<style>
  .kontak {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }
  @media (min-width: 60rem) {
    .kontak {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      align-items: start;
    }
  }

  .kontak__sub {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-bottom: 1rem;
  }

  .kanal {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .kanal a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.16s ease, transform 0.16s ease;
  }
  .kanal a:hover {
    border-color: var(--accent);
    transform: translateX(3px);
  }
  .kanal__ikon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border-radius: var(--radius);
    background: var(--accent-wash);
    color: var(--accent-ink);
  }
  .kanal__teks {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.35;
  }
  .kanal__teks strong {
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .kanal__teks span {
    font-size: var(--text-xs);
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .kontak__sosial {
    margin-top: 1.75rem;
  }
  .kontak__catatan {
    font-size: var(--text-xs);
    color: var(--muted-2);
    margin-bottom: 0.6rem;
  }

  /* ------------------------------------------------------------ form */
  .form {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .form .kontak__sub {
    margin-bottom: 0;
  }

  .form__peringatan {
    background: var(--accent-wash);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    padding: 0.7rem 0.9rem;
    font-size: var(--text-sm);
    color: var(--accent-ink);
  }
  .form__peringatan code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgb(255 255 255 / 0.7);
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
  }

  .form__row {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 36rem) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field label {
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-size: var(--text-base);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .field textarea {
    resize: vertical;
    min-height: 7rem;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    background: var(--surface);
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgb(242 162 12 / 0.22);
  }
  .field input:user-invalid,
  .field textarea:user-invalid {
    border-color: #c0442f;
  }

  .form__aksi {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    padding-top: 0.35rem;
  }
  .form__status {
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .form__status[data-state='ok'] {
    color: var(--live-ink);
  }
  .form__status[data-state='err'] {
    color: #c0442f;
  }
  .form button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#form-kontak');
  const KEY = 'htl:kontak:last';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-label]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const setStatus = (t: string, s?: 'ok' | 'err') => {
      status.textContent = t;
      if (s) status.dataset.state = s;
      else delete status.dataset.state;
    };

    if (!form.reportValidity()) return;

    // rate limit sederhana di sisi klien (5 menit)
    const last = Number(sessionStorage.getItem(KEY) ?? 0);
    if (Date.now() - last < 5 * 60_000) {
      setStatus('Tunggu beberapa menit sebelum mengirim lagi.', 'err');
      return;
    }

    btn.disabled = true;
    label.textContent = 'Mengirim…';
    setStatus('Mengirim pesan…');

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const data = await res.json();

      if (data.success) {
        sessionStorage.setItem(KEY, String(Date.now()));
        form.reset();
        setStatus('Terkirim. Terima kasih, saya akan membalas segera.', 'ok');
      } else {
        setStatus(data.message || 'Gagal mengirim. Coba lewat email.', 'err');
      }
    } catch {
      setStatus('Jaringan bermasalah. Coba lagi atau kirim lewat email.', 'err');
    } finally {
      btn.disabled = false;
      label.textContent = 'Kirim Pesan';
    }
  });
</script>
