---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ContactSection from '../components/ContactSection.astro';
import { profile } from '../lib/content';
---

<Base
  title="Kontak"
  description={`Hubungi ${profile.namaSosial} untuk kerja sama proyek: pengembangan web, jaringan & server, atau sistem PLTS dan monitoring.`}
>
  <PageHead
    label="Kontak"
    title="Mari bicarakan proyek Anda"
    lead="Isi formulir di bawah atau hubungi langsung lewat kanal yang nyaman. Saya berbasis di Jambi dan bekerja jarak jauh untuk klien di mana saja."
  />

  <section class="section">
    <div class="wrap">
      <ContactSection />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="blok">
        <p class="readout blok__label">Yang bisa dikerjakan</p>
        <ul class="blok__list">
          <li>Pengembangan & pemeliharaan website institusi atau bisnis</li>
          <li>Setup jaringan, server, dan self-hosting (Nginx, Docker, Proxmox)</li>
          <li>Sistem PLTS: inverter hybrid, panel surya, monitoring Modbus</li>
          <li>Dashboard & integrasi data untuk kebutuhan operasional</li>
        </ul>
      </div>
      <p class="blok__catatan">
        Alamat rumah dan nomor pribadi sengaja tidak ditampilkan. Untuk percakapan panjang,
        WhatsApp atau email lebih nyaman.
      </p>
    </div>
  </section>
</Base>

<style>
  .blok {
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }
  .blok__label {
    color: var(--muted-2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.65rem;
    margin-bottom: 0.9rem;
  }
  .blok__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }
  @media (min-width: 46rem) {
    .blok__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem 2rem;
    }
  }
  .blok__list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: var(--text-sm);
    line-height: 1.55;
  }
  .blok__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    background: var(--accent);
    transform: rotate(45deg);
  }

  .blok__catatan {
    margin-top: 1.25rem;
    max-width: 62ch;
    font-size: var(--text-sm);
    color: var(--muted);
  }
</style>
