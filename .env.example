# Salin ke .env lalu isi. File .env tidak ikut di-commit.

# URL final situs (tanpa slash di akhir) — dipakai untuk canonical, OG, sitemap.
SITE_URL=https://contoh-domain-anda.id

# Access key Web3Forms (https://web3forms.com) — untuk form kontak.
# Tanpa ini, form tetap tampil tapi menampilkan peringatan "belum aktif".
WEB3FORMS_KEY=

# Opsional: token GitHub untuk menaikkan rate limit saat build (5000/jam).
GITHUB_TOKEN=

# Opsional: YouTube Data API v3 key untuk menampilkan jumlah subscriber.
# Tanpa ini, bagian subscriber disembunyikan (video tetap jalan via RSS).
YOUTUBE_API_KEY=

# Opsional: lama cache data API dalam jam (default 6).
CACHE_TTL_JAM=6
