---
interface Props {
  site: {
    nama: string;
    url: string;
    deskripsi: string;
    peran: string;
    tanggungJawab?: string;
    stack: string[];
    status: string;
    screenshot?: string;
  };
  index?: number;
}
const { site, index = 0 } = Astro.props;
const host = new URL(site.url).hostname.replace(/^www\./, '');
const aktif = site.status === 'aktif';
const label = host.split('.')[0].replace(/[^a-z0-9]/gi, '');
const inisial = (label.slice(0, 2) || site.nama.slice(0, 2)).toUpperCase();
---

<article class="site">
  <div class="site__shot">
    {
      site.screenshot ? (
        <img src={site.screenshot} alt={`Tampilan ${site.nama}`} width="1200" height="675" loading="lazy" decoding="async" />
      ) : (
        <div class="site__kosong">
          <span class="site__mono" aria-hidden="true">{inisial}</span>
          <span class="readout">{host}</span>
        </div>
      )
    }
    <span class:list={['site__status', aktif ? 'is-aktif' : 'is-lain']}>
      <span class="site__led" aria-hidden="true"></span>
      {site.status}
    </span>
    <span class="site__idx readout">{String(index + 1).padStart(2, '0')}</span>
  </div>

  <div class="site__body">
    <div class="site__judul">
      <h3>{site.nama}</h3>
      <span class="site__peran readout">{site.peran}</span>
    </div>

    <p class="site__desc">{site.deskripsi}</p>
    {site.tanggungJawab && <p class="site__tugas">{site.tanggungJawab}</p>}

    <ul class="site__stack" aria-label="Teknologi">
      {site.stack.map((s) => <li class="chip">{s}</li>)}
    </ul>

    <a class="site__kunjungi" href={site.url} target="_blank" rel="noopener noreferrer">
      <span class="site__host readout">{host}</span>
      Kunjungi
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17 17 7M9 7h8v8"></path>
      </svg>
    </a>
  </div>
</article>

<style>
  .site {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  .site:hover {
    border-color: var(--line-strong);
    transform: translateY(-3px);
    box-shadow: var(--shadow-pop);
  }

  .site__shot {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--panel);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .site__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .site__kosong {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    height: 100%;
    background-image: linear-gradient(
        to right,
        rgb(255 255 255 / 0.05) 1px,
        transparent 1px
      ),
      linear-gradient(to bottom, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 28px 28px;
    color: var(--on-panel-muted);
  }
  .site__mono {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.05);
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: 0.02em;
  }
  .site__kosong .readout {
    letter-spacing: 0.06em;
    font-size: 0.7rem;
  }

  .site__status,
  .site__idx {
    position: absolute;
    top: 0.65rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    background: rgb(21 17 12 / 0.82);
    color: var(--on-panel);
    backdrop-filter: blur(4px);
  }
  .site__status {
    left: 0.65rem;
    text-transform: uppercase;
  }
  .site__idx {
    right: 0.65rem;
    color: var(--on-panel-muted);
  }
  .site__led {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted-2);
  }
  .is-aktif .site__led {
    background: var(--live);
    box-shadow: 0 0 0 3px rgb(62 167 118 / 0.22);
  }
  .is-aktif {
    color: #c6f2dd;
  }

  .site__body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.1rem 1.2rem 1.2rem;
    flex: 1;
  }
  .site__judul {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .site__judul h3 {
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .site__peran {
    color: var(--accent-ink);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.65rem;
  }

  .site__desc {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }
  .site__tugas {
    font-size: var(--text-sm);
    color: var(--text);
    padding-top: 0.6rem;
    border-top: 1px dashed var(--line);
  }

  .site__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site__kunjungi {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.85rem;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--text);
  }
  .site__kunjungi:hover {
    color: var(--accent-ink);
  }
  .site__host {
    color: var(--muted-2);
    letter-spacing: 0.03em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .site__kunjungi svg {
    margin-left: auto;
    flex: none;
    transition: transform 0.15s ease;
  }
  .site__kunjungi:hover svg {
    transform: translate(2px, -2px);
  }
</style>
