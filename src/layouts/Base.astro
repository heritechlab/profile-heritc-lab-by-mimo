---
import '../styles/global.css';
import '@fontsource-variable/archivo';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteMeta } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  ogPath?: string;
  noIndex?: boolean;
}

const {
  title,
  description = siteMeta.description,
  ogPath = '/og.png',
  noIndex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${siteMeta.name}` : siteMeta.name;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImage = new URL(ogPath, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#15110c" />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteMeta.name} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteMeta.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/rss+xml" title={siteMeta.name} href="/rss.xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#konten">Lewati ke konten utama</a>
    <SiteHeader />
    <main id="konten">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
