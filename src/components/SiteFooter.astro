---
import { profile, social } from '../lib/content';
import { nav, siteMeta } from '../lib/site';
import Icon from './Icon.astro';

const tahun = new Date().getFullYear();
const kanal = social.sosial.filter((s) => s.url);
---

<footer class="foot">
  <div class="wrap foot__inner">
    <div class="foot__brand">
      <span class="foot__glyph" aria-hidden="true">HTL</span>
      <div>
        <p class="foot__nama">{siteMeta.name}</p>
        <p class="foot__bio">{profile.posisi} · {profile.lokasi}</p>
      </div>
    </div>

    <nav class="foot__nav" aria-label="Navigasi bawah">
      <ul>
        {[{ href: '/', label: 'Beranda' }, ...nav].map((i) => (
          <li><a href={i.href}>{i.label}</a></li>
        ))}
      </ul>
    </nav>

    <ul class="foot__sosial" aria-label="Media sosial">
      {
        kanal.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer me">
              <Icon name={s.platform} size={17} />
              <span class="visually-hidden">{s.nama}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="wrap foot__bawah">
    <p class="readout">© {tahun} {profile.nama}</p>
    <p class="readout foot__note">Dibangun dengan Astro · Data diperbarui otomatis saat build</p>
  </div>
</footer>

<style>
  .foot {
    background: var(--ink);
    color: var(--on-panel);
    border-top: 3px solid var(--accent);
    padding-block: clamp(2.25rem, 5vw, 3.25rem) 1.5rem;
  }

  .foot__inner {
    display: grid;
    gap: 1.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--panel-line);
  }
  @media (min-width: 56rem) {
    .foot__inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) auto;
      align-items: start;
    }
  }

  .foot__brand {
    display: flex;
    gap: 0.85rem;
    align-items: center;
  }
  .foot__glyph {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    background: var(--accent);
    color: var(--ink);
    border-radius: 3px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.75rem;
  }
  .foot__nama {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .foot__bio {
    color: var(--on-panel-muted);
    font-size: var(--text-sm);
  }

  .foot__nav ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.15rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .foot__nav a {
    display: inline-block;
    padding-block: 5px;
    color: var(--on-panel-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color 0.15s ease;
  }
  .foot__nav a:hover {
    color: var(--accent);
  }

  .foot__sosial {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .foot__sosial a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--panel-line);
    border-radius: var(--radius);
    color: var(--on-panel-muted);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .foot__sosial a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .foot__bawah {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding-top: 1.25rem;
    color: var(--on-panel-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
  }
  .foot__note {
    color: var(--on-panel-muted);
    opacity: 0.75;
  }
</style>
